# .env — переменные окружения для docker-compose
# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не коммитится (см. .gitignore) — держите секреты только локально.

# Пароль пользователя Postgres appuser (совпадает с DB_PASSWORD внутри backend).
# Обязателен — без него POSTGRES_PASSWORD будет пустым и контейнер car-db
# не запустится (healthcheck постоянно будет падать в "unhealthy").
DB_PASSWORD=

# Прайс поставщика: положите актуальный CSV в backend/price-data/autobody_carscan_catalog.csv.
# Если этого файла нет, читается autobody.csv. Для другого файла задайте путь внутри контейнера.
CARSCAN_PARTS_CSV=
# Формат снимка: колонки vehicle, supplier_sku, oem_raw, price_rub, price_type,
# stock_moscow_pechatniki, stock_moscow_kapotnya, snapshot_moscow, source.
CARSCAN_PARTS_MAX_AGE_HOURS=24

# Для qwen3.8-27b выберите selectel и укажите ключ и HTTPS URL из кабинета Selectel.
# SELECTEL_BASE_URL принимает адрес API с путём /v1 или полный URL метода chat/completions.
CARSCAN_VISION_PROVIDER=yandex
SELECTEL_API_KEY=
SELECTEL_BASE_URL=

# Ключ 2ГИС Places API для поиска кузовного ремонта по геопозиции.
TWOGIS_API_KEY=

# Публичные IPv4/IPv6 тестировщиков через запятую, исключаемые из метрик.
CARSCAN_INTERNAL_IPS=

# Логин администратора и хеш пароля для /admin.html.
# Сгенерируйте хеш командой ниже. Пароль вводится скрытно и в .env не сохраняется.
# python3 -c 'import getpass, hashlib, secrets; salt = secrets.token_bytes(16); password = getpass.getpass("Admin password: ").encode(); print(salt.hex() + ":" + hashlib.scrypt(password, salt=salt, n=32768, r=8, p=1, maxmem=67108864, dklen=32).hex())'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Ключи ЮKassa для приёма платежей.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# SMTP для отправки OTP-кодов входа (необязательно — без них код виден
# только в логах бэкенда, письма не отправляются).
SMTP_USER=
SMTP_PASSWORD=
