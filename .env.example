# .env — переменные окружения для docker-compose
# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не коммитится (см. .gitignore) — держите секреты только локально.

# Пароль пользователя Postgres appuser (совпадает с DB_PASSWORD внутри backend).
# Обязателен — без него POSTGRES_PASSWORD будет пустым и контейнер car-db
# не запустится (healthcheck постоянно будет падать в "unhealthy").
DB_PASSWORD=

# Почта администратора (используется бэкендом, например для уведомлений).
ADMIN_EMAIL=

# Ключи ЮKassa для приёма платежей.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# SMTP для отправки OTP-кодов входа (необязательно — без них код виден
# только в логах бэкенда, письма не отправляются).
SMTP_USER=
SMTP_PASSWORD=
